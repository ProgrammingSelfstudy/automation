# cp .env.example .env 后按需修改。
# `docker compose` 和 `make run` 都会自动读取项目根目录下的 .env。

# --- MySQL（docker-compose 用来起本地开发用的 MySQL 容器）---
MYSQL_ROOT_PASSWORD=devpassword
MYSQL_DATABASE=loadtest

# --- cmd/server 运行时读取的环境变量 ---
MYSQL_DSN=root:devpassword@tcp(127.0.0.1:3306)/loadtest?parseTime=true

# 32 字节 AES-256 key，base64 编码，用于账号密码加密存储。
# 生成命令：make key   （或者直接 openssl rand -base64 32）
ACCOUNT_ENCRYPTION_KEY=

LISTEN_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:5173
