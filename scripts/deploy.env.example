# 复制成 scripts/deploy.env（已加入 .gitignore，不会提交）再改成你自己的值。
# 前提：本机已经用 ssh-copy-id 把公钥装到服务器上，deploy.sh 全程不问密码：
#   ssh-copy-id -i ~/.ssh/id_ed25519.pub root@<服务器地址>

SERVER=root@your-server-ip
APP_DIR=/opt/interface-load-test/app
BIN_PATH=/opt/interface-load-test/bin/server
SERVICE_NAME=interface-load-test
APP_USER=interface-load-test
